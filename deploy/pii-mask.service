# systemd user-unit для микросервиса pii-mask.
# Ставится deploy.sh в ~/.config/systemd/user/ (нужен loginctl enable-linger).
#
# Путь абсолютный и указывает на рабочее дерево репозитория, а не на копию в
# домашнем каталоге. Прежняя редакция вела в %h/pii-mask - вторую копию, которую
# удалили 06.09.2026. Служба этого не заметила: процесс, поднятый из удаленного
# каталога, продолжал работать месяц на коде от 20.08, /health/live отвечал ok,
# а любой реальный запрос отдавал 500. Проверять надо не "жив ли порт", а
# откуда запущен процесс: ps -o cmd -p $(systemctl --user show pii-mask -p MainPID --value)
[Unit]
Description=pii-mask - local PII masking gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=/data/git/pii-mask
ExecStart=/data/git/pii-mask/.venv/bin/pii-mask serve --host 127.0.0.1 --port 8377
Restart=on-failure
RestartSec=3
# в stdout сервиса нет тел запросов (см. api.py) - journald безопасен

[Install]
WantedBy=default.target
